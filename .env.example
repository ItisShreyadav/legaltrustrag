# LegalTrustRAG configuration. Copy to .env.local (local development) or .env
# (docker compose) and fill in the values. Blank or commented-out variables use
# the defaults shown. Never commit the filled-in copy.

# --- Claude -------------------------------------------------------------------
# Required to run analyses. The app starts without it, but POST /api/analyze
# answers 503 until it is set.
ANTHROPIC_API_KEY=
# Model id for clause typing, NLI, compliance checks and verification.
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Storage ------------------------------------------------------------------
# SQLite file for users, sessions, saved runs and reviews (relative paths resolve
# against the server's working directory). Default: ./data/ltr.sqlite
# LTR_DB_PATH=./data/ltr.sqlite
# Where downloaded Hugging Face models are cached. Default: inside
# node_modules/@huggingface/transformers/.cache. The Docker image uses /app/data/hf-cache.
# LTR_MODEL_CACHE_DIR=./data/hf-cache

# --- Accounts and security ------------------------------------------------------
# Allow anyone who can reach the server to create an account. Set to false once
# your team's accounts exist; /api/auth/signup then answers 403.
# LTR_ALLOW_SIGNUP=true
# Session cookie Secure flag. Unset = on in production. Set to false only when
# serving production over plain HTTP on a trusted network (browsers drop Secure
# cookies on http:// origins other than localhost).
# LTR_COOKIE_SECURE=
# Number of reverse proxies in front of the app that append to X-Forwarded-For
# (true = 1). Leave unset when the app is reached directly: the header is then
# ignored, because clients can forge it. Used for per-IP sign-in/sign-up limits.
# LTR_TRUST_PROXY=false

# --- Limits -------------------------------------------------------------------
# Maximum size of each uploaded document, in MB (0.1-100).
# LTR_MAX_UPLOAD_MB=10
# Maximum documents per analysis (1-20).
# LTR_MAX_FILES=5
# Analyses each user may start per hour (0 = unlimited).
# LTR_ANALYZE_RATE_LIMIT=10

# --- Logging ------------------------------------------------------------------
# JSON log threshold: debug | info | warn | error
# LTR_LOG_LEVEL=info

# --- Pipeline tuning (optional; also respected by the eval scripts) ------------
# Parallel Claude calls per analysis.
# LTR_CONCURRENCY=4
# Cap on candidate clause pairs sent to the NLI engine (unset = no cap).
# LTR_MAX_PAIRS=
# Findings below this combined confidence (0-1) are withheld.
# LTR_CONFIDENCE_THRESHOLD=0.55
# 1 = lexical relevance gate instead of a Claude call during verification.
# LTR_FAST_VERIFY=0
# Claude effort: low | medium | high | xhigh | max, or none to omit the parameter.
# LTR_EFFORT=
# 0 = disable server-side refusal fallbacks on models that support them.
# LTR_FALLBACKS=1
# 1 = BM25-only retrieval: never load (or download) the embedding and reranker models.
# LTR_DISABLE_EMBEDDINGS=0
# Cross-encoder reranker: a Hugging Face id or a local model folder.
# LTR_RERANK_MODEL=Xenova/bge-reranker-base
# Folder of local models; <dir>/<LTR_RERANK_MODEL>/config.json is loaded from disk.
# LTR_LOCAL_MODELS_DIR=
# ONNX precision: fp32 | fp16 | q8 | int8 | uint8 | q4
# LTR_EMBED_DTYPE=fp32
# LTR_RERANK_DTYPE=q8
